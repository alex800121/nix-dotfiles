diff --git a/cmake/libtcc.cmake b/cmake/libtcc.cmake
--- a/cmake/libtcc.cmake
+++ b/cmake/libtcc.cmake
@@ -80,6 +80,16 @@ if(APPLE)
     string(APPEND tcc_config
         "#define CONFIG_TCC_SYSINCLUDEPATHS \"{B}/include:${tcc_sdk}/usr/include\"\n")
 endif()
+# Permit toolchains with nonstandard system header and library paths (e.g.
+# NixOS) to supply them at configure time, keeping TinyCC's staged paths first.
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND GOOSE_TCC_SYSINCLUDEPATHS)
+    string(APPEND tcc_config
+        "#define CONFIG_TCC_SYSINCLUDEPATHS \"{B}/include:${GOOSE_TCC_SYSINCLUDEPATHS}\"\n")
+endif()
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND GOOSE_TCC_LIBPATHS)
+    string(APPEND tcc_config
+        "#define CONFIG_TCC_LIBPATHS \"{B}:${GOOSE_TCC_LIBPATHS}\"\n")
+endif()
 # Written only when it changes, so reconfiguring does not rebuild TinyCC.
 file(CONFIGURE OUTPUT "${TCC_BUILD}/config.h" CONTENT "${tcc_config}" @ONLY)
 # --- the library and the driver ----------------------------------------------
